<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="zad2.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="30" Margin="30">
            <Editor x:Name="InputEditor"/>
            <Button Text="Dodaj wpis" Clicked="Zapisz"/>
            <Button Text="Wyczyść dziennik" Clicked="Usun"/>
            <Label x:Name="Label1" />
            <Label x:Name="Data" FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
